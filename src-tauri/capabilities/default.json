{
  "$schema": "https://schema.tauri.app/acl/manifest/2",
  "identifier": "default",
  "description": "Default permissions for the main and splash windows",
  "windows": ["main", "splash"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/relationship-graph-backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
